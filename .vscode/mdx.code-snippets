{
  "Import Writing Components": {
    "scope": "mdx,markdown",
    "prefix": ["imports", "import-writing"],
    "body": [
      "import Callout from '@/components/callout.astro'",
      "import Figure from '@/components/figure.astro'",
      "import ImageGrid from '@/components/image-grid.astro'",
    ],
    "description": "Import Callout, Figure, and ImageGrid components",
  },
  "Import Callout": {
    "scope": "mdx,markdown",
    "prefix": "import-callout",
    "body": ["import Callout from '@/components/callout.astro'"],
    "description": "Import Callout component",
  },
  "Import Figure": {
    "scope": "mdx,markdown",
    "prefix": "import-figure",
    "body": ["import Figure from '@/components/figure.astro'"],
    "description": "Import Figure component",
  },
  "Import ImageGrid": {
    "scope": "mdx,markdown",
    "prefix": "import-imggrid",
    "body": ["import ImageGrid from '@/components/image-grid.astro'"],
    "description": "Import ImageGrid component",
  },
  "Code Block": {
    "scope": "mdx,markdown",
    "prefix": ["code", "codeblock"],
    "body": [
      "```${1|bash,sh,zsh,js,ts,tsx,jsx,json,yaml,toml,css,html,md,mdx,python,sql,dockerfile,text|}",
      "${2:code}",
      "```",
    ],
    "description": "Insert a fenced code block",
  },
  "Code Block With Title": {
    "scope": "mdx,markdown",
    "prefix": ["code-title", "codefile"],
    "body": [
      "```${1|bash,sh,zsh,js,ts,tsx,jsx,json,yaml,toml,css,html,md,mdx,python,sql,dockerfile,text|} title=\"${2:path/to/file}\"",
      "${3:code}",
      "```",
    ],
    "description": "Insert an Expressive Code block with a title",
  },
  "Code Block Without Line Numbers": {
    "scope": "mdx,markdown",
    "prefix": "code-noline",
    "body": [
      "```${1|bash,sh,zsh,js,ts,tsx,jsx,json,yaml,toml,css,html,md,mdx,python,sql,dockerfile,text|} showLineNumbers=false",
      "${2:code}",
      "```",
    ],
    "description": "Insert an Expressive Code block with line numbers disabled",
  },
  "Collapsible Code Block": {
    "scope": "mdx,markdown",
    "prefix": "code-collapse",
    "body": [
      "```${1|bash,sh,zsh,js,ts,tsx,jsx,json,yaml,toml,css,html,md,mdx,python,sql,dockerfile,text|} title=\"${2:path/to/file}\" collapse={${3:1-5}}",
      "${4:code}",
      "```",
    ],
    "description": "Insert an Expressive Code block with collapsible line ranges",
  },
  "Diff Code Block": {
    "scope": "mdx,markdown",
    "prefix": ["diff", "codediff"],
    "body": [
      "```diff lang=\"${1|js,ts,tsx,jsx,json,yaml,css,html,md,python,sql,text|}\" title=\"${2:path/to/file}\"",
      "- ${3:old line}",
      "+ ${4:new line}",
      "```",
    ],
    "description": "Insert an Expressive Code diff block",
  },
  "Inline Code": {
    "scope": "mdx,markdown",
    "prefix": ["g", "gaoliang", "高亮", "inline-code"],
    "body": ["`${TM_SELECTED_TEXT:${1:高亮内容}}`"],
    "description": "Insert inline code backticks",
  },
  "Keyboard Key": {
    "scope": "mdx,markdown",
    "prefix": ["kbd", "key"],
    "body": ["<kbd>${TM_SELECTED_TEXT:${1:Ctrl}}</kbd>"],
    "description": "Insert an inline keyboard key",
  },
  "Callout": {
    "scope": "mdx,markdown",
    "prefix": "callout",
    "body": [
      "<Callout variant=\"${1|note,tip,warning,danger,important,definition,theorem,lemma,proof,corollary,proposition,axiom,conjecture,notation,remark,intuition,recall,explanation,example,exercise,problem,answer,solution,summary|}\" title=\"${2:标题}\">",
      "  ${3:内容}",
      "</Callout>",
    ],
    "description": "Insert a Callout block",
  },
  "Folded Callout": {
    "scope": "mdx,markdown",
    "prefix": "callout-folded",
    "body": [
      "<Callout",
      "  variant=\"${1|note,tip,warning,danger,important,definition,theorem,lemma,proof,corollary,proposition,axiom,conjecture,notation,remark,intuition,recall,explanation,example,exercise,problem,answer,solution,summary|}\"",
      "  title=\"${2:标题}\"",
      "  defaultOpen={false}",
      ">",
      "  ${3:内容}",
      "</Callout>",
    ],
    "description": "Insert a collapsed Callout block",
  },
  "Figure": {
    "scope": "mdx,markdown",
    "prefix": "fig",
    "body": [
      "<Figure",
      "  src=\"${1:https://cdn.jsdmirror.com/gh/xingpingcn/picx-images-hosting@master/path/to/image.webp}\"",
      "  caption=\"${2:图片说明}\"",
      "/>",
    ],
    "description": "Insert a Figure block",
  },
  "ImageGrid": {
    "scope": "mdx,markdown",
    "prefix": ["image", "imggrid"],
    "body": [
      "<ImageGrid",
      "  images={[",
      "    {",
      "      src: '${1:https://cdn.jsdmirror.com/gh/xingpingcn/picx-images-hosting@master/path/to/a.webp}',",
      "      caption: '${2:图片说明}',",
      "    },",
      "    {",
      "      src: '${3:https://cdn.jsdmirror.com/gh/xingpingcn/picx-images-hosting@master/path/to/b.webp}',",
      "      caption: '${4:图片说明}',",
      "    },",
      "  ]}",
      "/>",
    ],
    "description": "Insert an ImageGrid block",
  },
  "Markdown Link": {
    "scope": "mdx,markdown",
    "prefix": "link",
    "body": ["[${1:链接文字}](${2:https://example.com})"],
    "description": "Insert a Markdown link",
  },
  "Blockquote": {
    "scope": "mdx,markdown",
    "prefix": "quote",
    "body": ["> ${1:引用内容}"],
    "description": "Insert a blockquote",
  },
  "Details": {
    "scope": "mdx,markdown",
    "prefix": "details",
    "body": [
      "<details>",
      "  <summary>${1:标题}</summary>",
      "",
      "  ${2:内容}",
      "</details>",
    ],
    "description": "Insert a details block",
  },
  "Markdown Table": {
    "scope": "mdx,markdown",
    "prefix": "table",
    "body": [
      "| ${1:列一} | ${2:列二} | ${3:列三} |",
      "| --- | --- | --- |",
      "| ${4:内容} | ${5:内容} | ${6:内容} |",
    ],
    "description": "Insert a Markdown table",
  },
  "Math Block": {
    "scope": "mdx,markdown",
    "prefix": "math",
    "body": ["$$", "${1:f(x) = x^2}", "$$"],
    "description": "Insert a math block",
  },
  "Horizontal Rule": {
    "scope": "mdx,markdown",
    "prefix": "hr",
    "body": ["---"],
    "description": "Insert a horizontal rule",
  },
}
