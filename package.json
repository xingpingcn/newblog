{
  "name": "newblog",
  "type": "module",
  "version": "1.6.3",
  "private": true,
  "scripts": {
    "dev": "npm run sync:image-metadata && astro dev",
    "start": "npm run dev",
    "build": "npm run sync:image-metadata && astro check && astro build && pagefind --site dist --glob \"**/index.html\" && npm run generate:html-redirects",
    "preview": "astro preview",
    "astro": "astro",
    "test:search": "node tests/search-contract.test.mjs",
    "test:format-cjk": "node tests/format-cjk-spacing.test.mjs",
    "sync:image-metadata": "node scripts/sync-image-metadata.mjs",
    "generate:html-redirects": "node scripts/generate-html-redirects.mjs",
    "prettier": "prettier --write \"**/*.{md,mdx}\" --ignore-path .gitignore",
    "format:cjk": "node scripts/format-cjk-spacing.mjs",
    "format": "npm run prettier && npm run format:cjk"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-satteri": "0.3.4",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@expressive-code/plugin-collapsible-sections": "0.42.0",
    "@expressive-code/plugin-line-numbers": "0.42.0",
    "@iconify-json/lucide": "1.2.119",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "astro": "7.1.3",
    "astro-icon": "1.1.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "github-slugger": "2.0.0",
    "hast-util-select": "6.0.4",
    "hast-util-to-html": "9.0.5",
    "hastscript": "9.0.1",
    "lucide-react": "1.26.0",
    "photoswipe": "5.4.4",
    "radix-ui": "1.6.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "satteri": "0.9.5",
    "satteri-expressive-code": "0.1.18",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "temml": "0.13.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-astro-organize-imports": "0.4.12",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-astro-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "volta": {
    "node": "24.15.0",
    "npm": "11.11.0"
  }
}
