---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { badgeVariants } from '@/components/ui/badge'
import Layout from '@/layouts/layout.astro'
import { getSortedTags } from '@/lib/data-utils'
import { tagHref } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

const sortedTags = await getSortedTags()
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="标签" />
  <Breadcrumbs items={[{ label: '标签', icon: 'lucide:tags' }]} />

  <section class="flex flex-col gap-4">
    <div>
      <h1 class="text-3xl font-medium">标签</h1>
      <p class="text-muted-foreground mt-2 text-sm">
        旧博客中显式标记过的标签。
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      {
        sortedTags.map(({ tag, count }) => (
          <Link href={tagHref(tag)} class={badgeVariants({ variant: 'muted' })}>
            <Icon name="lucide:hash" class="size-3" />
            {tag}
            <span class="text-muted-foreground ml-1.5">({count})</span>
          </Link>
        ))
      }
    </div>
  </section>
</Layout>
