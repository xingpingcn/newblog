---
import HomePage from '@/components/home-page.astro'
import PageHead from '@/components/page-head.astro'
import SiteStructuredData from '@/components/site-structured-data.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getAllAuthors, getAllPosts, getSortedTags } from '@/lib/data-utils'

const posts = await getAllPosts()
const blog = posts.slice(0, SITE.postsPerPage)
const tags = await getSortedTags()
const authors = await getAllAuthors()
const author = authors.find((item) => item.id === 'xingpingcn') ?? authors[0]
const totalPages = Math.ceil(posts.length / SITE.postsPerPage)
---

<Layout class="max-w-6xl">
  <PageHead slot="head" title="首页" />
  <SiteStructuredData slot="head" />
  <link slot="head" rel="alternate" type="text/markdown" href="/index.md" />
  {
    totalPages > 1 && (
      <link slot="head" rel="next" href={new URL('/page/2/', SITE.href).href} />
    )
  }
  <HomePage
    posts={blog}
    author={author}
    tags={tags}
    currentPage={1}
    totalPages={totalPages}
  />
</Layout>
