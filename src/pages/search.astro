---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import SearchPaginationTemplate from '@/components/search-pagination-template.astro'
import SearchResultTemplate from '@/components/search-result-template.astro'
import SearchStatus from '@/components/search-status.astro'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'
---

<Layout class="max-w-read">
  <PageHead
    slot="head"
    title="搜索"
    canonical={new URL('/search/', Astro.site).href}
  />
  <Breadcrumbs
    items={[
      { label: '首页', href: '/', icon: 'lucide:home' },
      { label: '搜索', icon: 'lucide:search' },
    ]}
  />

  <section
    class="flex min-h-[calc(100vh-18rem)] flex-col gap-6"
    data-pagefind-ignore="all"
  >
    <div class="search-page-heading">
      <p class="search-dialog-kicker">
        <Icon name="lucide:search" class="size-3.5" />
        站内搜索
      </p>
      <h1 class="text-3xl leading-tight font-medium sm:text-4xl">搜索文章</h1>
    </div>

    <search-page class="contents">
      <form class="search-shell" data-search-form role="search">
        <div class="search-input-wrap">
          <Icon name="lucide:search" class="search-input-icon size-4" />
          <input
            id="search-page-input"
            class="search-input"
            name="q"
            type="search"
            placeholder="搜索文章"
            autocomplete="off"
            enterkeyhint="search"
            data-search-input
            aria-controls="search-page-results"
          />
          <button
            type="button"
            class="search-clear"
            aria-label="清空搜索"
            title="清空搜索"
            hidden
            data-search-clear
          >
            <Icon name="lucide:x" class="size-4" />
          </button>
        </div>
        <button
          type="submit"
          class={buttonVariants({
            variant: 'default',
            className: 'search-submit',
          })}
        >
          <Icon name="lucide:search" class="size-4" />
          搜索
        </button>
      </form>

      <SearchStatus />

      <ol id="search-page-results" class="search-results" data-search-results>
      </ol>
      <div
        class="search-pagination-container"
        data-search-pagination-container
        hidden
      >
      </div>

      <SearchResultTemplate />
      <SearchPaginationTemplate />
    </search-page>
  </section>
</Layout>

<script>
  import {
    SEARCH_PAGE_SIZE,
    loadResultData,
    renderSearchPagination,
    renderSearchResult,
    searchPageHref,
    searchPagefind,
  } from '@/lib/search-client'

  function getPageNumber(rawPage: string | null) {
    const page = Number.parseInt(rawPage ?? '1', 10)
    return Number.isFinite(page) && page > 0 ? page : 1
  }

  class SearchPage extends HTMLElement {
    private controller?: AbortController
    private inputSearchTimer?: number
    private searchId = 0

    connectedCallback() {
      const form = this.querySelector<HTMLFormElement>('[data-search-form]')
      const input = this.querySelector<HTMLInputElement>('[data-search-input]')
      const clearButton = this.querySelector<HTMLButtonElement>(
        '[data-search-clear]',
      )
      const statusText = this.querySelector<HTMLElement>(
        '[data-search-status-text]',
      )
      const idleStatus = this.querySelector<HTMLElement>(
        '[data-search-status-idle]',
      )
      const loadingStatus = this.querySelector<HTMLElement>(
        '[data-search-status-loading]',
      )
      const results = this.querySelector<HTMLOListElement>(
        '[data-search-results]',
      )
      const paginationContainer = this.querySelector<HTMLElement>(
        '[data-search-pagination-container]',
      )
      const resultTemplate = this.querySelector<HTMLTemplateElement>(
        '[data-search-result-template]',
      )
      const paginationTemplate = this.querySelector<HTMLTemplateElement>(
        '[data-search-pagination-template]',
      )

      if (
        !form ||
        !input ||
        !clearButton ||
        !statusText ||
        !idleStatus ||
        !loadingStatus ||
        !results ||
        !paginationContainer ||
        !resultTemplate ||
        !paginationTemplate
      ) {
        return
      }

      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller
      const params = new URLSearchParams(window.location.search)
      const initialQuery = params.get('q')?.trim() ?? ''
      const initialPage = getPageNumber(params.get('page'))

      input.value = initialQuery
      clearButton.hidden = initialQuery.length === 0

      form.addEventListener(
        'submit',
        (event) => {
          event.preventDefault()
          this.cancelPendingSearch()
          const query = input.value.trim()
          this.updateUrl(query, 1)
          void this.runSearch(
            query,
            1,
            input,
            clearButton,
            statusText,
            idleStatus,
            loadingStatus,
            results,
            paginationContainer,
            resultTemplate,
            paginationTemplate,
          )
        },
        { signal },
      )

      input.addEventListener(
        'input',
        () => {
          clearButton.hidden = input.value.trim().length === 0
          this.cancelPendingSearch()
          this.inputSearchTimer = window.setTimeout(() => {
            this.inputSearchTimer = undefined
            const query = input.value.trim()
            this.updateUrl(query, 1)
            void this.runSearch(
              query,
              1,
              input,
              clearButton,
              statusText,
              idleStatus,
              loadingStatus,
              results,
              paginationContainer,
              resultTemplate,
              paginationTemplate,
            )
          }, 120)
        },
        { signal },
      )

      clearButton.addEventListener(
        'click',
        () => {
          this.cancelPendingSearch()
          input.value = ''
          clearButton.hidden = true
          this.updateUrl('', 1)
          void this.runSearch(
            '',
            1,
            input,
            clearButton,
            statusText,
            idleStatus,
            loadingStatus,
            results,
            paginationContainer,
            resultTemplate,
            paginationTemplate,
          )
          input.focus({ preventScroll: true })
        },
        { signal },
      )

      if (initialQuery) {
        void this.runSearch(
          initialQuery,
          initialPage,
          input,
          clearButton,
          statusText,
          idleStatus,
          loadingStatus,
          results,
          paginationContainer,
          resultTemplate,
          paginationTemplate,
        )
      } else {
        this.setStatus(
          statusText,
          idleStatus,
          loadingStatus,
          '输入关键词开始搜索。',
          false,
        )
        input.focus({ preventScroll: true })
      }
    }

    private updateUrl(query: string, page: number) {
      history.replaceState(null, '', searchPageHref(query, page))
    }

    private cancelPendingSearch() {
      if (this.inputSearchTimer === undefined) return
      window.clearTimeout(this.inputSearchTimer)
      this.inputSearchTimer = undefined
    }

    private setStatus(
      statusText: HTMLElement,
      idleStatus: HTMLElement,
      loadingStatus: HTMLElement,
      text: string,
      loading: boolean,
    ) {
      statusText.textContent = text
      idleStatus.hidden = loading
      loadingStatus.hidden = !loading
    }

    private async runSearch(
      rawQuery: string,
      requestedPage: number,
      input: HTMLInputElement,
      clearButton: HTMLButtonElement,
      statusText: HTMLElement,
      idleStatus: HTMLElement,
      loadingStatus: HTMLElement,
      results: HTMLOListElement,
      paginationContainer: HTMLElement,
      resultTemplate: HTMLTemplateElement,
      paginationTemplate: HTMLTemplateElement,
    ) {
      const query = rawQuery.trim()
      const currentSearchId = ++this.searchId
      input.setAttribute('aria-busy', query ? 'true' : 'false')
      clearButton.hidden = query.length === 0
      results.replaceChildren()
      paginationContainer.replaceChildren()
      paginationContainer.hidden = true

      if (!query) {
        this.setStatus(
          statusText,
          idleStatus,
          loadingStatus,
          '输入关键词开始搜索。',
          false,
        )
        return
      }

      this.setStatus(statusText, idleStatus, loadingStatus, '正在搜索...', true)

      try {
        const search = await searchPagefind(query)
        if (currentSearchId !== this.searchId) return

        const pageCount = Math.max(
          1,
          Math.ceil(search.total / SEARCH_PAGE_SIZE),
        )
        const currentPage = Math.min(requestedPage, pageCount)
        if (currentPage !== requestedPage) this.updateUrl(query, currentPage)

        const start = (currentPage - 1) * SEARCH_PAGE_SIZE
        const visibleResults = await loadResultData(
          search.results,
          start,
          start + SEARCH_PAGE_SIZE,
        )
        if (currentSearchId !== this.searchId) return

        results.replaceChildren(
          ...visibleResults.map((result) =>
            renderSearchResult(result, resultTemplate, query),
          ),
        )
        renderSearchPagination(
          paginationContainer,
          paginationTemplate,
          search.total,
          currentPage,
          (page) => {
            this.updateUrl(query, page)
            void this.runSearch(
              query,
              page,
              input,
              clearButton,
              statusText,
              idleStatus,
              loadingStatus,
              results,
              paginationContainer,
              resultTemplate,
              paginationTemplate,
            )
          },
        )
        this.setStatus(
          statusText,
          idleStatus,
          loadingStatus,
          search.total > 0
            ? `找到 ${search.total} 个结果。`
            : '没有找到匹配文章。',
          false,
        )
      } catch (error) {
        console.error(error)
        if (currentSearchId !== this.searchId) return
        this.setStatus(
          statusText,
          idleStatus,
          loadingStatus,
          '搜索索引加载失败，请刷新页面后重试。',
          false,
        )
      } finally {
        if (currentSearchId === this.searchId) {
          input.setAttribute('aria-busy', 'false')
        }
      }
    }
  }

  if (!customElements.get('search-page')) {
    customElements.define('search-page', SearchPage)
  }
</script>
