---
import ArticleLicense from '@/components/article-license.astro'
import Breadcrumbs from '@/components/breadcrumbs.astro'
import GiscusComments from '@/components/giscus-comments.astro'
import Link from '@/components/link.astro'
import PhotoSwipe from '@/components/photo-swipe.astro'
import PostHead from '@/components/post-head.astro'
import PostNavigation from '@/components/post-navigation.astro'
import SubpostsHeader from '@/components/subposts-header.astro'
import SubpostsSidebar from '@/components/subposts-sidebar.astro'
import TOCHeader from '@/components/toc-header.astro'
import TOCSidebar from '@/components/toc-sidebar.astro'
import { badgeVariants } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Skeleton } from '@/components/ui/skeleton'
import Layout from '@/layouts/layout.astro'
import {
  getAdjacentPosts,
  getAllPostsAndSubposts,
  getCombinedReadingTime,
  getParentId,
  getParentPost,
  getPostReadingTime,
  getSubpostCount,
  getTOCSections,
  hasSubposts,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { getResponsiveCdnImage } from '@/lib/cdn-images'
import { formatDate, tagHref } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getAllPostsAndSubposts()
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }))
}

const post = Astro.props
const currentPostId = Astro.params.id
const { Content, headings } = await render(post)
const authors = await parseAuthors(post.data.authors ?? [])

const isCurrentSubpost = isSubpost(currentPostId)
const navigation = await getAdjacentPosts(currentPostId)
const parentPost = isCurrentSubpost ? await getParentPost(currentPostId) : null

const hasChildPosts = await hasSubposts(currentPostId)
const subpostCount = !isCurrentSubpost
  ? await getSubpostCount(currentPostId)
  : 0
const postReadingTime = await getPostReadingTime(currentPostId)
const combinedReadingTime =
  hasChildPosts && !isCurrentSubpost
    ? await getCombinedReadingTime(currentPostId)
    : null
const formattedDate = formatDate(post.data.date)
const responsiveCoverImage = post.data.coverImage
  ? getResponsiveCdnImage(post.data.coverImage)
  : undefined

const tocSections = await getTOCSections(currentPostId)
---

<Layout>
  <PostHead slot="head" post={post} />
  <PhotoSwipe />
  {
    (hasChildPosts || isCurrentSubpost) && (
      <SubpostsHeader
        slot="subposts-navigation"
        parentId={isCurrentSubpost ? getParentId(currentPostId) : currentPostId}
      />
    )
  }
  {
    headings?.length > 0 &&
      !(
        isCurrentSubpost &&
        headings.length === 1 &&
        headings[0].text === post.data.title
      ) && <TOCHeader slot="table-of-contents" headings={headings} />
  }

  <section
    class="grid grid-cols-[minmax(0px,1fr)_min(calc(var(--container-read)-2rem),100%)_minmax(0px,1fr)] gap-y-6"
  >
    <div class="col-start-2">
      <Breadcrumbs
        items={[
          { href: '/blog', label: '博客', icon: 'lucide:library-big' },
          ...(isCurrentSubpost && parentPost
            ? [
                {
                  href: `/${parentPost.id}`,
                  label: parentPost.data.title,
                  icon: 'lucide:book-open',
                },
                {
                  href: `/${currentPostId}`,
                  label: post.data.title,
                  icon: 'lucide:file-text',
                },
              ]
            : [
                {
                  href: `/${currentPostId}`,
                  label: post.data.title,
                  icon: 'lucide:book-open-text',
                },
              ]),
        ]}
      />
    </div>

    {
      post.data.image ? (
        <div class="bg-muted/30 relative col-span-full mx-auto aspect-[1200/630] w-full max-w-5xl overflow-hidden">
          <Skeleton className="absolute inset-0 size-full rounded-none" />
          <Image
            src={post.data.image}
            alt={post.data.title}
            width={1200}
            height={630}
            class="bg-background absolute inset-0 size-full object-cover"
          />
        </div>
      ) : (
        post.data.coverImage && (
          <div class="bg-muted/30 relative col-span-full mx-auto aspect-[1200/630] w-full max-w-5xl overflow-hidden">
            <Skeleton className="absolute inset-0 size-full rounded-none" />
            <img
              src={responsiveCoverImage?.src ?? post.data.coverImage}
              srcset={responsiveCoverImage?.srcset}
              sizes={
                responsiveCoverImage
                  ? '(min-width: 1056px) 64rem, calc(100vw - 2rem)'
                  : undefined
              }
              alt={post.data.title}
              width="1200"
              height="630"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="bg-background absolute inset-0 size-full object-contain"
            />
          </div>
        )
      )
    }

    <section class="col-start-2 flex flex-col gap-y-6 text-center">
      <div class="flex flex-col">
        <h1
          class="mb-2 scroll-mt-31 text-3xl leading-tight font-semibold sm:text-4xl"
          id="post-title"
        >
          {post.data.title}
        </h1>

        <p class="sr-only" data-pagefind-meta="description">
          {post.data.description}
        </p>
        <time
          class="sr-only"
          datetime={post.data.date.toISOString()}
          data-pagefind-meta={`date:${formattedDate}`}
          data-pagefind-sort={`date:${post.data.date.toISOString()}`}
        >
          {formattedDate}
        </time>

        <div
          class="text-muted-foreground divide-border mb-4 flex flex-col items-center justify-center divide-y text-xs sm:flex-row sm:flex-wrap sm:divide-x sm:divide-y-0 sm:text-sm"
        >
          {
            authors.length > 0 && (
              <div class="flex w-full items-center justify-center gap-x-2 py-2 sm:w-fit sm:px-2 sm:py-0 first:sm:pl-0 last:sm:pr-0">
                {authors.map((author) => (
                  <div class="flex items-center gap-x-1.5">
                    <Image
                      src={author.avatar}
                      alt={author.name}
                      width={20}
                      height={20}
                      class="rounded-full"
                    />
                    {author.isRegistered ? (
                      <Link
                        href={`/authors/${author.id}`}
                        underline
                        class="text-foreground"
                      >
                        <span>{author.name}</span>
                      </Link>
                    ) : (
                      <span>{author.name}</span>
                    )}
                  </div>
                ))}
              </div>
            )
          }

          <div
            class="flex w-full items-center justify-center gap-2 py-2 sm:w-fit sm:px-2 sm:py-0 first:sm:pl-0 last:sm:pr-0"
          >
            <span>{formatDate(post.data.date)}</span>
          </div>

          <div
            class="flex w-full items-center justify-center gap-2 py-2 sm:w-fit sm:px-2 sm:py-0 first:sm:pl-0 last:sm:pr-0"
          >
            <span>
              {postReadingTime}
              {
                combinedReadingTime &&
                  combinedReadingTime !== postReadingTime && (
                    <span class="text-muted-foreground">
                      {' '}
                      ({combinedReadingTime} total)
                    </span>
                  )
              }
            </span>
          </div>

          {
            subpostCount > 0 && (
              <div class="flex w-full items-center justify-center gap-1 py-2 sm:w-fit sm:px-2 sm:py-0 first:sm:pl-0 last:sm:pr-0">
                <Icon name="lucide:file-text" class="size-3" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </div>
            )
          }
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          {
            post.data.tags &&
              post.data.tags.length > 0 &&
              post.data.tags.map((tag) => (
                <a
                  href={tagHref(tag)}
                  class={badgeVariants({ variant: 'muted' })}
                  data-pagefind-filter="tag"
                >
                  <Icon name="lucide:hash" class="size-3" />
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </section>

    {
      tocSections.length > 0 && (
        <TOCSidebar sections={tocSections} currentPostId={currentPostId} />
      )
    }

    <article
      class="prose col-start-2 max-w-none"
      data-pagefind-body
      data-article-content
    >
      <span
        class="sr-only"
        data-pagefind-meta="title"
        data-pagefind-weight="4"
      >{post.data.title}</span>
      <Content />
    </article>

    {
      (hasChildPosts || isCurrentSubpost) && (
        <SubpostsSidebar
          parentId={
            isCurrentSubpost ? getParentId(currentPostId) : currentPostId
          }
          className="w-64"
        />
      )
    }

    <ArticleLicense post={post} />

    <PostNavigation
      newerPost={navigation.newer}
      olderPost={navigation.older}
      parentPost={isCurrentSubpost ? navigation.parent : undefined}
    />

    {post.data.comments !== false && <GiscusComments />}
  </section>

  <!-- 自身是文档顶部的 1px 哨兵，靠两个 IntersectionObserver 判断显隐，
       不再需要每次滚动都读 footer 的 getBoundingClientRect -->
  <scroll-to-top class="pointer-events-none absolute top-0 left-0 block size-px">
    <Button
      variant="outline"
      size="icon"
      className="group pointer-events-auto fixed right-8 bottom-8 z-50 hidden"
      title="Scroll to top"
      aria-label="Scroll to top"
    >
      <Icon
        name="lucide:arrow-up"
        class="mx-auto size-4 transition-all group-hover:-translate-y-0.5"
      />
    </Button>
  </scroll-to-top>

  <script>
    class ScrollToTop extends HTMLElement {
      private observers: IntersectionObserver[] = []
      private button: HTMLElement | null = null
      private isNearTop = true
      private isFooterVisible = false

      connectedCallback() {
        this.button = this.querySelector('button')
        if (!this.button) return

        this.button.addEventListener('click', this.handleClick)

        const topObserver = new IntersectionObserver(
          (entries) => {
            this.isNearTop = entries[entries.length - 1]!.isIntersecting
            this.sync()
          },
          { rootMargin: '300px 0px 0px 0px' },
        )
        topObserver.observe(this)
        this.observers.push(topObserver)

        const footer = document.querySelector('footer')
        if (footer) {
          const footerObserver = new IntersectionObserver((entries) => {
            this.isFooterVisible = entries[entries.length - 1]!.isIntersecting
            this.sync()
          })
          footerObserver.observe(footer)
          this.observers.push(footerObserver)
        }
      }

      disconnectedCallback() {
        this.button?.removeEventListener('click', this.handleClick)
        for (const observer of this.observers) observer.disconnect()
        this.observers = []
      }

      private handleClick = () => {
        window.scrollTo({
          top: 0,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'auto'
            : 'smooth',
        })
      }

      private sync() {
        if (!this.button) return
        const shouldHide = this.isNearTop || this.isFooterVisible
        /* hidden 和 inline-flex 都是 display 工具类，twMerge 只会留下最后一个，
           所以显隐必须成对切换，否则显示时会退回 inline-block */
        this.button.classList.toggle('hidden', shouldHide)
        this.button.classList.toggle('inline-flex', !shouldHide)
      }
    }

    if (!customElements.get('scroll-to-top')) {
      customElements.define('scroll-to-top', ScrollToTop)
    }
  </script>
</Layout>
