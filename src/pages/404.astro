---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/layout.astro'
import { cn } from '@/lib/utils'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="404" noindex />
  <Breadcrumbs items={[{ label: '???', icon: 'lucide:circle-help' }]} />

  <section
    class="flex flex-col items-center justify-center gap-y-4 text-center"
  >
    <div class="max-w-md">
      <h1 class="mb-4 text-3xl font-medium">404：页面不存在</h1>
      <p class="prose">
        这个地址没有对应的公开页面。请从首页、文章归档或站点地图继续查找。
      </p>
      <ul class="prose mt-4 list-disc pl-5 text-left">
        <li><Link href="/">首页</Link></li>
        <li><Link href="/blog">文章归档</Link></li>
        <li><Link href="/sitemap.xml">站点地图</Link></li>
        <li><Link href="/llms.txt">llms.txt</Link></li>
      </ul>
    </div>
    <Link
      href="/"
      class={cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}
    >
      <span class="transition-transform group-hover:-translate-x-1">&larr;</span
      > Go to home page
    </Link>
  </section>
</Layout>
