---
import { SITE } from '@/consts'
import { Icon } from 'astro-icon/components'

const { comments } = SITE
const { giscus } = comments
---

<section
  id="comments"
  class="not-prose col-start-2 scroll-mt-28 rounded-md border bg-muted/20 px-4 py-4"
  aria-labelledby="comments-title"
>
  <div class="mb-4 flex items-center gap-2">
    <Icon
      name="lucide:messages-square"
      class="size-4 shrink-0 text-muted-foreground"
    />
    <h2 id="comments-title" class="text-sm font-medium text-foreground">
      {comments.title}
    </h2>
  </div>

  <giscus-comments
    class="block min-h-40"
    data-repo={giscus.repo}
    data-repo-id={giscus.repoId}
    data-category={giscus.category}
    data-category-id={giscus.categoryId}
    data-mapping={giscus.mapping}
    data-strict={giscus.strict}
    data-reactions-enabled={giscus.reactionsEnabled}
    data-emit-metadata={giscus.emitMetadata}
    data-input-position={giscus.inputPosition}
    data-lang={giscus.lang}
    data-theme-light={giscus.theme.light}
    data-theme-dark={giscus.theme.dark}
  >
  </giscus-comments>
</section>

<script is:inline data-astro-rerun>
  class GiscusComments extends HTMLElement {
    themeObserver

    connectedCallback() {
      this.load()
      this.observeTheme()
    }

    disconnectedCallback() {
      this.themeObserver?.disconnect()
    }

    load() {
      if (this.querySelector('iframe.giscus-frame, script')) return

      const script = document.createElement('script')
      script.src = 'https://giscus.app/client.js'
      script.async = true
      script.crossOrigin = 'anonymous'
      script.setAttribute('data-repo', this.dataset.repo ?? '')
      script.setAttribute('data-repo-id', this.dataset.repoId ?? '')
      script.setAttribute('data-category', this.dataset.category ?? '')
      script.setAttribute('data-category-id', this.dataset.categoryId ?? '')
      script.setAttribute('data-mapping', this.dataset.mapping ?? 'pathname')
      script.setAttribute('data-strict', this.dataset.strict ?? '0')
      script.setAttribute(
        'data-reactions-enabled',
        this.dataset.reactionsEnabled ?? '1',
      )
      script.setAttribute(
        'data-emit-metadata',
        this.dataset.emitMetadata ?? '0',
      )
      script.setAttribute(
        'data-input-position',
        this.dataset.inputPosition ?? 'top',
      )
      script.setAttribute('data-theme', this.currentGiscusTheme())
      script.setAttribute('data-lang', this.dataset.lang ?? 'zh-CN')

      this.appendChild(script)
    }

    observeTheme() {
      this.themeObserver?.disconnect()

      this.themeObserver = new MutationObserver(() => {
        this.updateTheme()
      })

      this.themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      })
    }

    currentGiscusTheme() {
      const isDark =
        document.documentElement.getAttribute('data-theme') === 'dark'

      return isDark
        ? (this.dataset.themeDark ?? 'dark')
        : (this.dataset.themeLight ?? 'light')
    }

    updateTheme() {
      const iframe = this.querySelector('iframe.giscus-frame')
      if (!iframe?.contentWindow) return

      iframe.contentWindow.postMessage(
        {
          giscus: {
            setConfig: {
              theme: this.currentGiscusTheme(),
            },
          },
        },
        'https://giscus.app',
      )
    }
  }

  if (!customElements.get('giscus-comments')) {
    customElements.define('giscus-comments', GiscusComments)
  }
</script>
