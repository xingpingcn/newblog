---
import Link from '@/components/link.astro'
import SocialIcons from '@/components/social-icons.astro'
import AvatarComponent from '@/components/ui/avatar'
import type { SocialLink } from '@/types'
import type { CollectionEntry } from 'astro:content'

interface Props {
  author: CollectionEntry<'authors'>
  compact?: boolean
  profileHref?: string
}

const { author, compact = false, profileHref = `/authors/${author.id}` } =
  Astro.props
const { name, avatar, bio, mail, website, github, twitter, linkedin } =
  author.data

const socialLinks: SocialLink[] = [
  website && { href: website, label: 'Website' },
  github && { href: github, label: 'GitHub' },
  twitter && { href: twitter, label: 'Twitter' },
  linkedin && { href: linkedin, label: 'LinkedIn' },
  mail && { href: `mailto:${mail}`, label: 'Email' },
].filter(Boolean) as SocialLink[]
---

<aside class="rounded-xl border p-5">
  <div
    class:list={[
      'flex items-center gap-4',
      compact ? 'lg:flex-col lg:text-center' : 'sm:items-start',
    ]}
  >
    <Link href={profileHref} class="shrink-0">
      <AvatarComponent
        client:load
        src={avatar}
        alt={`Avatar of ${name}`}
        fallback={name[0]}
        className="size-24 rounded-full"
      />
    </Link>

    <div
      class:list={[
        'min-w-0 grow',
        compact && 'lg:flex lg:flex-col lg:items-center',
      ]}
    >
      <h2 class="text-xl font-medium">{name}</h2>
      {bio && <p class="text-muted-foreground mt-1 text-sm leading-6">{bio}</p>}
      <div class="mt-4">
        <SocialIcons links={socialLinks} />
      </div>
    </div>
  </div>
</aside>
