<div
  class="site-navigation-progress"
  data-state="idle"
  aria-hidden="true"
  transition:persist
>
  <div class="site-navigation-progress-track"></div>
</div>

<script>
  const progress = document.querySelector<HTMLElement>(
    '.site-navigation-progress',
  )

  if (progress && !progress.dataset.bound) {
    progress.dataset.bound = 'true'

    let startTimer: number | undefined
    let finishTimer: number | undefined
    let resetTimer: number | undefined
    let fallbackTimer: number | undefined
    let isNavigationPreparing = false
    let restoreTraverseScroll: (() => void) | undefined

    const clearTimers = () => {
      window.clearTimeout(startTimer)
      window.clearTimeout(finishTimer)
      window.clearTimeout(resetTimer)
      window.clearTimeout(fallbackTimer)
    }

    const isModifiedClick = (event: PointerEvent) =>
      event.metaKey || event.ctrlKey || event.shiftKey || event.altKey

    const isNavigableLink = (link: HTMLAnchorElement) => {
      const target = link.getAttribute('target')
      const href = link.getAttribute('href')

      if (!href || href.startsWith('#') || link.hasAttribute('download')) {
        return false
      }

      if (target && target !== '_self') {
        return false
      }

      const url = new URL(link.href)
      return (
        url.origin === window.location.origin &&
        (url.pathname !== location.pathname || url.search !== location.search)
      )
    }

    const getHistoryScrollPosition = () => {
      const state = history.state as
        | { scrollX?: unknown; scrollY?: unknown }
        | null

      if (
        typeof state?.scrollX !== 'number' ||
        typeof state.scrollY !== 'number'
      ) {
        return null
      }

      return {
        left: state.scrollX,
        top: state.scrollY,
      }
    }

    const isAstroTopReset = (args: unknown[]) => {
      if (args.length !== 1) {
        return false
      }

      const options = args[0]

      if (!options || typeof options !== 'object') {
        return false
      }

      const { behavior, left, top } = options as ScrollToOptions

      return (
        behavior === 'instant' &&
        Number(left ?? 0) === 0 &&
        Number(top ?? 0) === 0
      )
    }

    const guardTraverseScrollRestore = () => {
      const savedPosition = getHistoryScrollPosition()

      if (!savedPosition) {
        return
      }

      const originalScrollTo = window.scrollTo
      const scrollTo = originalScrollTo.bind(window) as typeof window.scrollTo
      let suppressTraverseTopScroll = true

      const patchedScrollTo = ((...args: [ScrollToOptions] | [number, number]) => {
        if (suppressTraverseTopScroll && isAstroTopReset(args)) {
          suppressTraverseTopScroll = false
          return
        }

        if (args.length === 1) {
          scrollTo(args[0])
          return
        }

        scrollTo(args[0], args[1])
      }) as typeof window.scrollTo

      window.scrollTo = patchedScrollTo

      restoreTraverseScroll = () => {
        if (window.scrollTo === patchedScrollTo) {
          window.scrollTo = originalScrollTo
        }

        scrollTo({
          left: savedPosition.left,
          top: savedPosition.top,
          behavior: 'instant',
        })
      }
    }

    const show = () => {
      window.clearTimeout(finishTimer)
      window.clearTimeout(resetTimer)
      progress.dataset.state = 'loading'
    }

    const start = () => {
      isNavigationPreparing = true
      window.clearTimeout(fallbackTimer)
      show()
    }

    const startSoon = () => {
      window.clearTimeout(startTimer)
      window.clearTimeout(fallbackTimer)
      startTimer = window.setTimeout(show, 80)
      fallbackTimer = window.setTimeout(() => {
        if (!isNavigationPreparing) {
          cancel()
        }
      }, 900)
    }

    const cancel = () => {
      window.clearTimeout(startTimer)
      window.clearTimeout(fallbackTimer)

      if (isNavigationPreparing) {
        return
      }

      progress.dataset.state = 'idle'
    }

    const finish = () => {
      window.clearTimeout(startTimer)
      window.clearTimeout(fallbackTimer)
      isNavigationPreparing = false

      if (progress.dataset.state !== 'loading') {
        return
      }

      progress.dataset.state = 'complete'
      finishTimer = window.setTimeout(() => {
        progress.dataset.state = 'idle'
      }, 180)
    }

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (
          event.button !== 0 ||
          isModifiedClick(event) ||
          event.defaultPrevented
        ) {
          return
        }

        const target = event.target
        const link =
          target instanceof Element
            ? target.closest<HTMLAnchorElement>('a[href]')
            : null

        if (link && isNavigableLink(link)) {
          startSoon()
        }
      },
      { passive: true },
    )

    window.addEventListener('pointercancel', cancel, { passive: true })
    window.addEventListener('touchmove', cancel, { passive: true })
    window.addEventListener('popstate', startSoon, { passive: true })

    document.addEventListener('astro:before-preparation', start)
    document.addEventListener('astro:after-preparation', () => {
      window.clearTimeout(startTimer)
      window.clearTimeout(fallbackTimer)
    })
    document.addEventListener('astro:before-swap', (event) => {
      if (
        'navigationType' in event &&
        event.navigationType === 'traverse'
      ) {
        guardTraverseScrollRestore()
      }
    })
    document.addEventListener('astro:after-swap', () => {
      restoreTraverseScroll?.()
      restoreTraverseScroll = undefined
    })
    document.addEventListener('astro:page-load', finish)
    window.addEventListener('hashchange', finish, { passive: true })
    window.addEventListener('pageshow', finish, { passive: true })

    window.addEventListener(
      'pagehide',
      () => {
        clearTimers()
        restoreTraverseScroll = undefined
        isNavigationPreparing = false
        progress.dataset.state = 'idle'
      },
      { passive: true },
    )
  }
</script>
