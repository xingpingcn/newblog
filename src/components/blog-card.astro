---
import AvatarComponent from '@/components/ui/avatar'
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import { Skeleton } from '@/components/ui/skeleton'
import {
  getCombinedReadingTime,
  getPostLinkTarget,
  getSubpostCount,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
  priorityImage?: boolean
}

const { entry, priorityImage = false } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
const linkTarget = getPostLinkTarget(entry)
---

<div
  class="hover:bg-muted/50 rounded-xl border p-4 transition-colors duration-300 ease-in-out"
>
  <Link
    href={linkTarget.href}
    external={linkTarget.external}
    class="flex flex-col gap-4 sm:flex-row"
  >
    {
      entry.data.image ? (
        <div class="bg-muted/30 relative aspect-[1200/630] w-full overflow-hidden rounded-md sm:max-w-3xs sm:shrink-0">
          <Skeleton className="absolute inset-0 size-full rounded-none transition-opacity duration-300 has-[+img[data-loaded=true]]:animate-none has-[+img[data-loaded=true]]:opacity-0" />
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={630}
            priority={priorityImage}
            class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-300 data-[loaded=true]:opacity-100"
            onload="this.dataset.loaded = 'true'"
          />
        </div>
      ) : (
        entry.data.coverImage && (
          <div class="bg-muted/30 relative aspect-[1200/630] w-full overflow-hidden rounded-md sm:max-w-3xs sm:shrink-0">
            <Skeleton className="absolute inset-0 size-full rounded-none transition-opacity duration-300 has-[+img[data-loaded=true]]:animate-none has-[+img[data-loaded=true]]:opacity-0" />
            <img
              src={entry.data.coverImage}
              alt={entry.data.title}
              width="1200"
              height="630"
              loading={priorityImage ? 'eager' : 'lazy'}
              decoding={priorityImage ? 'sync' : 'async'}
              fetchpriority={priorityImage ? 'high' : undefined}
              class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-300 data-[loaded=true]:opacity-100"
              onload="this.dataset.loaded = 'true'"
            />
          </div>
        )
      )
    }

    <div class="grow">
      <div class="mb-1 flex flex-wrap items-center gap-2">
        {
          entry.data.pinned && (
            <Badge variant="outline" className="gap-x-1">
              <Icon name="lucide:pin" class="size-3" />
              置顶
            </Badge>
          )
        }
        <h3 class="text-lg font-medium">{entry.data.title}</h3>
      </div>
      <p class="text-muted-foreground mb-2 text-sm">{entry.data.description}</p>

      <div
        class="text-muted-foreground mb-2 flex flex-wrap items-center gap-x-2 text-xs"
      >
        {
          authors.length > 0 && (
            <>
              {authors.map((author) => (
                <div class="flex items-center gap-x-1.5">
                  <AvatarComponent
                    client:load
                    src={author.avatar}
                    alt={author.name}
                    fallback={author.name[0]}
                    className="size-5 rounded-full"
                  />
                  <span>{author.name}</span>
                </div>
              ))}
              <Separator orientation="vertical" className="h-4!" />
            </>
          )
        }
        <span>{formattedDate}</span>
        <Separator orientation="vertical" className="h-4!" />
        <span>{readTime}</span>
        {
          subpostCount > 0 && (
            <>
              <Separator orientation="vertical" className="h-4!" />
              <span class="flex items-center gap-1">
                <Icon name="lucide:file-text" class="size-3" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </span>
            </>
          )
        }
      </div>

      {
        entry.data.tags && (
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <Badge variant="muted" className="flex items-center gap-x-1">
                <Icon name="lucide:hash" class="size-3" />
                {tag}
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</div>
