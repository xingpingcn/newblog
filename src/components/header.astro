---
import Link from '@/components/link.astro'
import ThemeToggle from '@/components/theme-toggle.astro'
import { buttonVariants } from '@/components/ui/button'
import { NAV_LINKS } from '@/consts'
import { Icon } from 'astro-icon/components'

interface Props {
  class?: string
}

const { class: className = 'max-w-3xl' } = Astro.props

const navIconMap: Record<string, string> = {
  首页: 'lucide:home',
  作者: 'lucide:users',
  标签: 'lucide:tags',
  统计: 'lucide:chart-no-axes-column-increasing',
  友链: 'lucide:heart-handshake',
  开往: 'lucide:train-front',
  关于: 'lucide:circle-user-round',
}

const secondaryNavLabels = new Set(['作者', '标签', '统计', '关于'])
const primaryNavLinks = NAV_LINKS.filter(
  (item) => !secondaryNavLabels.has(item.label),
)
const secondaryNavLinks = NAV_LINKS.filter((item) =>
  secondaryNavLabels.has(item.label),
)
const logoCdnRoot =
  'https://cdn.jsdmirror.com/gh/xingpingcn/picx-images-hosting@master/optimized/newblog/logo'
---

<site-header-motion class="site-header-motion">
  <div
    class:list={[
      'site-header-inner mx-auto flex w-full items-center justify-between gap-4 px-4 py-3',
      className,
    ]}
  >
    <span class="site-header-shell" aria-hidden="true"></span>
    <Link
      href="/"
      aria-label="首页"
      title="首页"
      class={buttonVariants({
        variant: 'outline',
        size: 'icon',
        className:
          'site-header-icon-button site-header-brand size-8 overflow-hidden p-0',
      })}
    >
      <img
        src={`${logoCdnRoot}/5beaa005-96.webp`}
        srcset={`${logoCdnRoot}/5beaa005-64.webp 64w, ${logoCdnRoot}/5beaa005-96.webp 96w`}
        sizes="32px"
        alt="Logo"
        width="32"
        height="32"
        loading="eager"
        decoding="async"
        fetchpriority="low"
        class="-m-px size-[calc(100%+2px)] max-w-none rounded-md object-cover"
      />
    </Link>
    <div class="site-header-actions flex items-center gap-2 sm:gap-3">
      <nav class="site-header-nav flex items-center gap-2 text-sm sm:gap-3">
        {
          primaryNavLinks.map((item) => (
            <Link
              href={item.href}
              external={item.external}
              rel={item.external ? 'noopener noreferrer' : undefined}
              data-nav-label={item.label}
              class="site-header-nav-link text-foreground/60 hover:text-foreground inline-flex items-center gap-1.5 whitespace-nowrap capitalize"
            >
              <Icon
                name={navIconMap[item.label] ?? 'lucide:circle'}
                class="size-3.5 shrink-0"
              />
              <span>{item.label}</span>
            </Link>
          ))
        }
      </nav>
      <div class="site-header-menu" data-open="false">
        <button
          type="button"
          class={buttonVariants({
            variant: 'outline',
            size: 'icon',
            className: 'site-header-icon-button site-header-menu-trigger size-8',
          })}
          aria-label="更多导航"
          aria-haspopup="menu"
          aria-expanded="false"
          data-site-header-menu-trigger
        >
          <Icon name="lucide:ellipsis-vertical" class="size-4" />
        </button>
        <div
          class="site-header-menu-panel"
          role="menu"
          aria-label="更多导航"
          data-site-header-menu-panel
        >
          {
            secondaryNavLinks.map((item) => (
              <Link
                href={item.href}
                external={item.external}
                rel={item.external ? 'noopener noreferrer' : undefined}
                role="menuitem"
                class="site-header-menu-item"
              >
                <Icon
                  name={navIconMap[item.label] ?? 'lucide:circle'}
                  class="size-4 shrink-0"
                />
                <span>{item.label}</span>
              </Link>
            ))
          }
        </div>
      </div>
      <button
        type="button"
        aria-label="搜索"
        title="搜索"
        class={buttonVariants({
          variant: 'outline',
          size: 'icon',
          className: 'site-header-icon-button site-header-search size-8',
        })}
        data-search-trigger
      >
        <Icon name="lucide:search" class="size-4" />
      </button>
      <Link
        href="https://github.com/xingpingcn/newblog"
        aria-label="源码"
        title="源码"
        class={buttonVariants({
          variant: 'outline',
          size: 'icon',
          className: 'site-header-icon-button size-8',
        })}
        rel="noopener noreferrer"
        external
      >
        <Icon name="lucide:github" class="size-4" />
      </Link>
      <ThemeToggle transition:persist />
    </div>
  </div>
</site-header-motion>

<script>
  class SiteHeaderMotion extends HTMLElement {
    private controller?: AbortController
    private resizeObserver?: ResizeObserver
    private headerAnimationId = 0
    private headerAnimations: Animation[] = []
    private updateAnimationFrame = 0

    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      this.updateAnimationFrame = 0
      const pageHeader = this.closest<HTMLElement>('.site-page-header')
      const inner = this.querySelector<HTMLElement>('.site-header-inner')
      const shell = this.querySelector<HTMLElement>('.site-header-shell')
      const brand = this.querySelector<HTMLElement>('.site-header-brand')
      const actions = this.querySelector<HTMLElement>('.site-header-actions')
      const menu = this.querySelector<HTMLElement>('.site-header-menu')
      const menuTrigger = this.querySelector<HTMLButtonElement>(
        '[data-site-header-menu-trigger]',
      )
      const getMobileArticleNavItems = () =>
        pageHeader
          ? [
              ...pageHeader.querySelectorAll<HTMLElement>(
                '.mobile-stack-summary-inner > *',
              ),
            ]
          : []
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      )

      let previousScrollY = window.scrollY
      let isHeaderVisible = true
      let motionHeight = 0
      let isHeaderStateReady = false

      const setMenuOpen = (isOpen: boolean) => {
        menu?.dataset && (menu.dataset.open = String(isOpen))
        menuTrigger?.setAttribute('aria-expanded', String(isOpen))
      }

      const syncMotionHeight = (height: number) => {
        if (!Number.isFinite(height) || height <= 0) return
        if (Math.abs(height - motionHeight) < 0.5) return
        motionHeight = height
        pageHeader?.style.setProperty(
          '--site-header-motion-height',
          `${height}px`,
        )
        pageHeader?.style.setProperty(
          '--site-header-motion-hide-offset',
          `${-height}px`,
        )
      }

      const applyHeaderDisplayState = (
        isNotTop: boolean,
        isVisible: boolean,
      ) => {
        this.classList.toggle('not-top', isNotTop)
        pageHeader?.classList.toggle('not-top', isNotTop)
        syncMotionHeight(this.getBoundingClientRect().height)
        this.dataset.show = String(isVisible)
        pageHeader?.toggleAttribute('data-header-hidden', !isVisible)
        if (!isVisible) {
          setMenuOpen(false)
        }
      }

      const resetHeaderAnimation = () => {
        for (const element of [
          shell,
          brand,
          actions,
          ...getMobileArticleNavItems(),
        ]) {
          if (!element) continue
          element.style.transformOrigin = ''
          element.style.willChange = ''
        }
      }

      const cancelHeaderAnimations = () => {
        this.headerAnimationId += 1
        for (const animation of this.headerAnimations) {
          animation.cancel()
        }
        this.headerAnimations = []
        resetHeaderAnimation()
      }

      const animateRect = (
        element: HTMLElement | null,
        fromRect: DOMRectReadOnly,
        toRect: DOMRectReadOnly,
        { scaleX = false }: { scaleX?: boolean } = {},
      ) => {
        if (!element || prefersReducedMotion.matches || toRect.width <= 0) {
          return undefined
        }

        const deltaX = fromRect.left - toRect.left
        const deltaY = fromRect.top - toRect.top
        const widthScale = scaleX ? fromRect.width / toRect.width : 1
        const shouldAnimate =
          Math.abs(deltaX) > 0.5 ||
          Math.abs(deltaY) > 0.5 ||
          Math.abs(widthScale - 1) > 0.002

        if (!shouldAnimate) return undefined

        element.style.transformOrigin = 'top left'
        element.style.willChange = 'transform'

        return element.animate(
          [
            {
              transform: `translate(${deltaX}px, ${deltaY}px) scaleX(${widthScale})`,
            },
            { transform: 'translate(0, 0) scaleX(1)' },
          ],
          {
            duration: 300,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'both',
          },
        )
      }

      const animateMobileArticleNavState = (
        beforeArticleNavRects: Map<HTMLElement, DOMRectReadOnly>,
        afterArticleNavRects: Map<HTMLElement, DOMRectReadOnly>,
      ) =>
        [...beforeArticleNavRects]
          .map(([element, fromRect]) => {
            const toRect = afterArticleNavRects.get(element)
            return toRect ? animateRect(element, fromRect, toRect) : undefined
          })
          .filter((animation): animation is Animation => Boolean(animation))

      const animateHeaderState = (isNotTop: boolean, isVisible: boolean) => {
        if (!inner || prefersReducedMotion.matches) {
          cancelHeaderAnimations()
          applyHeaderDisplayState(isNotTop, isVisible)
          return
        }

        const fromShellRect = (shell ?? inner).getBoundingClientRect()
        const fromBrandRect = brand?.getBoundingClientRect()
        const fromActionsRect = actions?.getBoundingClientRect()
        const beforeArticleNavRects = new Map(
          getMobileArticleNavItems().map((element) => [
            element,
            element.getBoundingClientRect(),
          ]),
        )
        cancelHeaderAnimations()
        applyHeaderDisplayState(isNotTop, isVisible)
        const toShellRect = (shell ?? inner).getBoundingClientRect()
        const toBrandRect = brand?.getBoundingClientRect()
        const toActionsRect = actions?.getBoundingClientRect()
        const afterArticleNavRects = new Map(
          getMobileArticleNavItems().map((element) => [
            element,
            element.getBoundingClientRect(),
          ]),
        )
        const animations = [
          animateRect(shell ?? inner, fromShellRect, toShellRect, {
            scaleX: true,
          }),
          fromBrandRect && toBrandRect
            ? animateRect(brand, fromBrandRect, toBrandRect)
            : undefined,
          fromActionsRect && toActionsRect
            ? animateRect(actions, fromActionsRect, toActionsRect)
            : undefined,
          ...animateMobileArticleNavState(
            beforeArticleNavRects,
            afterArticleNavRects,
          ),
        ].filter((animation): animation is Animation => Boolean(animation))

        if (animations.length === 0) {
          resetHeaderAnimation()
          return
        }

        const animationId = ++this.headerAnimationId
        this.headerAnimations = animations
        Promise.all(
          animations.map((animation) =>
            animation.finished.catch(() => undefined),
          ),
        ).then(() => {
          if (this.headerAnimationId !== animationId) return
          for (const animation of animations) {
            animation.cancel()
          }
          this.headerAnimations = []
          resetHeaderAnimation()
        })
      }

      const update = () => {
        const currentScrollY = window.scrollY
        const isNotTop = currentScrollY > 20
        const scrollDelta = currentScrollY - previousScrollY
        const isScrollingDown = scrollDelta > 8
        const isScrollingUp = scrollDelta < -8
        let nextHeaderVisible = isHeaderVisible

        if (currentScrollY < 350) {
          nextHeaderVisible = true
        } else if (isScrollingDown) {
          nextHeaderVisible = false
        } else if (isScrollingUp) {
          nextHeaderVisible = true
        }

        const isHeaderVisibilityChanged = isHeaderVisible !== nextHeaderVisible
        isHeaderVisible = nextHeaderVisible

        if (!isHeaderStateReady) {
          applyHeaderDisplayState(isNotTop, isHeaderVisible)
          isHeaderStateReady = true
        } else if (
          this.classList.contains('not-top') !== isNotTop ||
          isHeaderVisibilityChanged
        ) {
          animateHeaderState(isNotTop, isHeaderVisible)
        }

        if (Math.abs(scrollDelta) > 8) {
          previousScrollY = currentScrollY
        }
      }

      const scheduleUpdate = () => {
        if (this.updateAnimationFrame) return
        this.updateAnimationFrame = requestAnimationFrame(() => {
          this.updateAnimationFrame = 0
          update()
        })
      }

      update()
      this.resizeObserver = new ResizeObserver((entries) => {
        const entry = entries[0]
        syncMotionHeight(
          this.getBoundingClientRect().height || entry?.contentRect.height || 0,
        )
      })
      this.resizeObserver.observe(this)

      menuTrigger?.addEventListener(
        'click',
        () => {
          setMenuOpen(menu?.dataset.open !== 'true')
        },
        { signal: this.controller.signal },
      )

      this.addEventListener(
        'click',
        (event) => {
          const target = event.target
          if (
            target instanceof Element &&
            target.closest('.site-header-menu-item')
          ) {
            setMenuOpen(false)
          }
        },
        { signal: this.controller.signal },
      )

      document.addEventListener(
        'click',
        (event) => {
          if (event.target instanceof Node && !this.contains(event.target)) {
            setMenuOpen(false)
          }
        },
        { signal: this.controller.signal },
      )

      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') {
            setMenuOpen(false)
            menuTrigger?.focus()
          }
        },
        { signal: this.controller.signal },
      )

      window.addEventListener('scroll', scheduleUpdate, {
        passive: true,
        signal: this.controller.signal,
      })
      window.addEventListener('resize', scheduleUpdate, {
        passive: true,
        signal: this.controller.signal,
      })
    }

    disconnectedCallback() {
      this.controller?.abort()
      this.resizeObserver?.disconnect()
      for (const animation of this.headerAnimations) {
        animation.cancel()
      }
      this.headerAnimations = []
      if (this.updateAnimationFrame) {
        cancelAnimationFrame(this.updateAnimationFrame)
        this.updateAnimationFrame = 0
      }
    }
  }

  if (!customElements.get('site-header-motion')) {
    customElements.define('site-header-motion', SiteHeaderMotion)
  }
</script>
