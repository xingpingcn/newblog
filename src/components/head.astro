---
import { SITE } from '@/consts'
import { ClientRouter } from 'astro:transitions'
import Favicons from './favicons.astro'
---

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="generator" content={Astro.generator} />

  <!-- 首屏所有图片（logo / 头像 / 封面）都在这个 CDN 上：
       提前握手，省掉首访时的 DNS + TCP + TLS 串行等待 -->
  <link rel="preconnect" href="https://cdn.jsdmirror.com" crossorigin />
  <link rel="dns-prefetch" href="https://cdn.jsdmirror.com" />
  <!-- 统计与评论不在关键路径上，只预解析 DNS -->
  <link rel="dns-prefetch" href="https://stats.xingpingcn.top" />
  <link rel="dns-prefetch" href="https://giscus.app" />

  <!-- 正文字体：不预载的话要等 CSS 解析完才被发现，会多一轮 FOUT -->
  <link
    rel="preload"
    href="/fonts/GeistVF.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />

  <meta name="HandheldFriendly" content="True" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  />
  <meta name="baidu-site-verification" content={SITE.verification.baidu} />
  {
    SITE.verification.google.map((content) => (
      <meta name="google-site-verification" content={content} />
    ))
  }
  <meta name="msvalidate.01" content={SITE.verification.bing} />
  <script
    is:inline
    defer
    fetchpriority="low"
    src={SITE.analytics.umami.src}
    data-website-id={SITE.analytics.umami.websiteId}></script>

  <meta
    name="theme-color"
    content="#121212"
    media="(prefers-color-scheme: dark)"
    data-site-theme-color
  />
  <meta
    name="theme-color"
    content="#ffffff"
    media="(prefers-color-scheme: light)"
    data-site-theme-color
  />

  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL('rss.xml', Astro.site)}
  />

  <Favicons />
  <ClientRouter />

  <slot />
</head>
