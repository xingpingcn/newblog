---
import { SITE } from '@/consts'
import { ClientRouter } from 'astro:transitions'
import Favicons from './favicons.astro'
---

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="generator" content={Astro.generator} />

  <meta name="HandheldFriendly" content="True" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  />
  <meta name="baidu-site-verification" content={SITE.verification.baidu} />
  {
    SITE.verification.google.map((content) => (
      <meta name="google-site-verification" content={content} />
    ))
  }
  <meta name="msvalidate.01" content={SITE.verification.bing} />
  <script
    is:inline
    async
    src={SITE.analytics.umami.src}
    data-website-id={SITE.analytics.umami.websiteId}></script>

  <meta
    name="theme-color"
    content="#121212"
    media="(prefers-color-scheme: dark)"
    data-site-theme-color
  />
  <meta
    name="theme-color"
    content="#ffffff"
    media="(prefers-color-scheme: light)"
    data-site-theme-color
  />
  <style is:inline>
    html[data-scroll-restore-pending] body {
      visibility: hidden;
    }
  </style>
  <script is:inline>
    ;(() => {
      const getSavedScrollPosition = () => {
        const state = history.state

        if (
          !state ||
          typeof state.scrollX !== 'number' ||
          typeof state.scrollY !== 'number' ||
          state.scrollY <= 0
        ) {
          return null
        }

        return {
          left: state.scrollX,
          top: state.scrollY,
        }
      }

      const navigationEntry = performance.getEntriesByType('navigation')[0]
      const isBackForwardNavigation =
        navigationEntry instanceof PerformanceNavigationTiming &&
        navigationEntry.type === 'back_forward'
      const savedPosition = isBackForwardNavigation
        ? getSavedScrollPosition()
        : null

      if (!savedPosition) {
        return
      }

      const root = document.documentElement
      root.setAttribute('data-scroll-restore-pending', '')

      const revealScrollRestoredPage = () => {
        root.removeAttribute('data-scroll-restore-pending')
      }

      const restoreSavedScroll = () => {
        window.scrollTo({
          left: savedPosition.left,
          top: savedPosition.top,
          behavior: 'instant',
        })
        requestAnimationFrame(revealScrollRestoredPage)
      }

      window.addEventListener('pageshow', restoreSavedScroll, {
        once: true,
      })
      window.setTimeout(revealScrollRestoredPage, 1200)
    })()
  </script>

  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL('rss.xml', Astro.site)}
  />

  <Favicons />
  <ClientRouter />

  <slot />
</head>
