---
import { cn } from '@/lib/utils'

/**
 * 原生滚动容器，替代 Radix ScrollArea。
 * 滚动条外观已经由 global.css 里的 ::-webkit-scrollbar 规则统一，
 * 因此不需要为了自定义滚动条把 React 送到客户端。
 *
 * 元素自身就是滚动容器，脚本用 [data-scroll-area-viewport] 找到它。
 */
interface Props {
  class?: string
  className?: string
  [key: string]: unknown
}

const { class: klass, className, ...rest } = Astro.props
---

<div
  data-slot="scroll-area"
  data-scroll-area-viewport
  class={cn('relative overflow-y-auto', className, klass)}
  {...rest}
>
  <slot />
</div>
